# Copy to .env and adjust. Every value here is a harmless demo default - there are
# no real credentials anywhere in this project. `.env` itself is git-ignored.

# Flask session signing key. Generate a real one for any non-demo use:
#   python -c "import secrets; print(secrets.token_hex(32))"
DEVICEADMIN_SECRET_KEY=change-me-for-anything-other-than-a-local-demo

DEVICEADMIN_APP_NAME=DemoCorp Device Admin
DEVICEADMIN_LOG_LEVEL=INFO
DEVICEADMIN_DEBUG=false

# SQLite file. In Docker this lives on a named volume (see compose.yaml).
DEVICEADMIN_DATABASE_PATH=data/deviceadmin.db
DEVICEADMIN_SEED_DEMO_DATA=true

# Which connector implementation to load. Only "mock" ships in this public edition.
DEVICEADMIN_CONNECTOR_MODE=mock
# Artificial delay per mock device call, in milliseconds (try 150 to feel real network latency).
DEVICEADMIN_MOCK_LATENCY_MS=0

# Background page monitor
DEVICEADMIN_PAGE_MONITOR=true
DEVICEADMIN_PAGE_POLL_SECONDS=15
DEVICEADMIN_PAGE_COOLDOWN_SECONDS=60
