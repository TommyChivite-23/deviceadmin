# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
build/
dist/

# Test / lint caches and coverage output
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Secrets and local configuration - NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# Runtime data (the demo database is regenerated from the seed script)
data/*
!data/.gitkeep
*.db
*.db-wal
*.db-shm
*.sqlite
*.log
logs/

# Editors / OS
.vs/
.vscode/
.idea/
*.user
Thumbs.db
.DS_Store
~$*
